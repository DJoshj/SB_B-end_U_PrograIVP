============================================================================
                Flujo: Inscribir un Estudiante en 4 Materias
============================================================================
# 1. Crear Carrera
POST /api/careers
{
  "nameCareer": "Ingeniería en Sistemas",
  "faculty": "Facultad de Ingeniería"
}
# Resultado: careerId = 1

# 2. Crear Usuario para Estudiante (asumiendo que ya existe)
# userId = 1

# 3. Crear Estudiante
POST /api/students
{
  "userId": 1,
  "carnet": "25-1281-2022",
  "name": "José Luis",
  "lastname": "Ramos Ramos",
  "email": "jose.ramos@example.com",
  "phone": "7890-1234",
  "address": "San Salvador",
  "careerId": 1
}
# Resultado: studentId = 1

# 4. Crear Periodo
POST /api/periods
{
  "name": "CICLO 2 - 2025",
  "year": 2025,
  "startDate": "2025-07-24",
  "endDate": "2025-12-20",
  "schedule": "Regular"
}
# Resultado: periodId = 1

# 5. Crear 4 Horarios
POST /api/schedules
{"days": "MARTES-JUEVES-SÁBADO", "schedule": "18:40-20:10"}  # scheduleId = 1
{"days": "SÁBADO", "schedule": "13:00-16:00"}                # scheduleId = 2
{"days": "DOMINGO", "schedule": "07:00-10:00"}               # scheduleId = 3
{"days": "LUNES-MIÉRCOLES", "schedule": "18:40-20:10"}       # scheduleId = 4

# 6. Crear 3 Aulas
POST /api/classrooms
{"name": "EN LÍNEA", "ability": 50, "building": "Virtual"}   # classroomId = 1
{"name": "BJ-AB 3", "ability": 35, "building": "Edificio B"} # classroomId = 2
{"name": "BJ-LAB 3", "ability": 30, "building": "Edificio B"}# classroomId = 3

# 7. Crear Usuario para Docente
# userId = 2

# 8. Crear Docente
POST /api/teachers
{
  "userId": 2,
  "teacherCode": "T001",
  "names": "Juan Carlos",
  "lastName": "Pérez López",
  "email": "juan.perez@utec.edu.sv",
  "specialty": "Programación"
}
# Resultado: teacherId = 1

# 9. Crear 4 Materias
POST /api/subjects
{"subjectCode": "ADCC1", "name": "Administración de Centros de Cómputo", "valueUnits": 4, "careerId": 1}  # subjectId = 1
{"subjectCode": "CIDI1", "name": "Sistemas Digitales Presencial", "valueUnits": 4, "careerId": 1}         # subjectId = 2
{"subjectCode": "PROG4", "name": "Programación IV Presencial", "valueUnits": 4, "careerId": 1}            # subjectId = 3
{"subjectCode": "SIOP1", "name": "Sistemas Operativos", "valueUnits": 4, "careerId": 1}                   # subjectId = 4

# 10. Asignar 4 Materias
POST /api/subject-assignments
{"subjectId": 1, "teacherId": 1, "periodId": 1, "scheduleId": 1, "classroomId": 1, "maximumCapacity": 30, "section": "02"}  # id = 1
{"subjectId": 2, "teacherId": 1, "periodId": 1, "scheduleId": 2, "classroomId": 2, "maximumCapacity": 35, "section": "01"}  # id = 2
{"subjectId": 3, "teacherId": 1, "periodId": 1, "scheduleId": 3, "classroomId": 3, "maximumCapacity": 30, "section": "02"}  # id = 3
{"subjectId": 4, "teacherId": 1, "periodId": 1, "scheduleId": 4, "classroomId": 1, "maximumCapacity": 30, "section": "01"}  # id = 4

# 11. Inscribir Estudiante en las 4 Materias
POST /api/inscriptions
{
  "studentId": 1,
  "periodId": 1,
  "subjectsAssigned": [1, 2, 3, 4]
}

# ✅ Resultado Esperado:
# - 4 inscripciones creadas
# - Cupos reducidos en cada materia
# - PDF generado con las 4 materias
# - Email enviado a jose.ramos@example.com
# - PDF guardado en: reportes/inscripciones/inscripcion_25-1281-2022_CICLO_2_2025_YYYYMMDD.pdf

# 12. Verificar Inscripciones
GET /api/inscriptions/student/1

# 13. Verificar Materia Asignada con Inscripciones
GET /api/subject-assignments/1/inscriptions

# 14. Descargar PDF
GET /api/reports/download/inscripcion_25-1281-2022_CICLO_2_2025_YYYYMMDD.pdf




